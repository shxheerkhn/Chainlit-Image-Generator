# Pollinations needs NO API key for basic use.
# Optional: set a token from https://auth.pollinations.ai for higher rate limits and no watermark.
POLLINATIONS_API_TOKEN=

# Image model. See available options at https://image.pollinations.ai/models
# Common choices: flux (default, high quality), turbo (faster)
POLLINATIONS_MODEL=flux

# Output image size in pixels
POLLINATIONS_WIDTH=1024
POLLINATIONS_HEIGHT=1024
